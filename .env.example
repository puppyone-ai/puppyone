# Required Cloud endpoints. Configure these per environment; application code
# does not carry fallback URLs.
VITE_DESKTOP_CLOUD_API_URL=https://api.puppyone.ai/api/v1
VITE_DESKTOP_CLOUD_WEB_URL=https://app.puppyone.ai
# Optional only for localhost API development against a hosted Git endpoint.
VITE_DESKTOP_CLOUD_GIT_ORIGIN=https://api.puppyone.ai

# Required by `npm run dev`. Endpoint configuration alone never starts Cloud.
PUPPYONE_DESKTOP_RENDERER_URL=http://127.0.0.1:5173
# external (default): use configured endpoints, spawn no Cloud processes.
# preview: explicitly manage local API + built login Web (no HMR).
# dev: explicitly manage local API + Web HMR when editing Web code.
PUPPYONE_LOCAL_CLOUD_MODE=external
# Managed modes require loopback API/Web URLs and the sibling Cloud path.
# First build preview in its frontend: npm run build:local-login
PUPPYONE_CLOUD_DEV_ROOT=../puppyone-cloud

# Optional only for an unpackaged Development updater test. Both are required.
# PUPPYONE_DESKTOP_DEV_UPDATE_URL=https://localhost.invalid/desktop/dev/mac/latest
# PUPPYONE_DESKTOP_FORCE_DEV_UPDATE_CONFIG=1

# Enable verbose updater logs in Electron.
# PUPPYONE_DESKTOP_UPDATE_LOG_CONSOLE=1

# Office editing is a PuppyOne-managed Cloud capability. Desktop intentionally
# has no Document Server URL, JWT, callback listener, or Docker configuration.

# Optional unpackaged-only template website for local integration testing.
# Packaged builds always use https://www.puppyone.ai.
# PUPPYONE_TEMPLATE_STORE_ORIGIN=http://127.0.0.1:3035
