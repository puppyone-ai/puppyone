    "smoke:csv-performance": "npm run build && node tests/support/runners/run-csv-editor-performance-smoke.mjs",
    "start": "node scripts/start-electron.mjs",
    "test": "vitest run",
    "test:updater-p0": "vitest run --config tests/config/vitest.updater-p0.config.mjs",
    "test:updater-p0:coverage": "vitest run --config tests/config/vitest.updater-p0.config.mjs --coverage",
    "test:git-auto-commit": "vitest run --config tests/config/vitest.git-auto-commit.config.mjs",
    "test:git-auto-commit:coverage": "vitest run --config tests/config/vitest.git-auto-commit.config.mjs --coverage",
    "test:desktop-platform-contracts": "vitest run tests/unit/platform/capabilities/desktopPlatformContract.test.mjs tests/unit/release/build-identity/desktopReleaseSet.test.mjs tests/integration/release/build-identity/desktopBuildIdentity.test.mjs tests/integration/release/build-identity/electron.build-info-service.test.mjs tests/unit/platform/capabilities/electron.platform-host.test.mjs tests/integration/terminal/startup/electron.terminal-agent-launch.test.mjs tests/integration/cloud/auth/electron.cloud-publish-git-credentials.test.mjs",
    "test:desktop-telemetry": "vitest run tests/unit/telemetry tests/component/telemetry tests/integration/telemetry",
    "check:desktop-telemetry-edge": "wrangler deploy --dry-run --config cloudflare/desktop-telemetry/wrangler.jsonc",
    "test:watch": "vitest",
    "bench:performance": "vitest bench --run --no-file-parallelism --maxWorkers=1",
    "build:native-drag": "node scripts/build-native-resource-drag.mjs",
    "smoke:resource-transfer": "npm run build:native-drag && electron tests/integration/platform/drag-drop/resource-transfer.smoke.mjs",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:integration": "vitest run tests/integration",
    "test:architecture": "vitest run tests/architecture",
    "test:e2e": "node tests/support/runners/run-desktop-e2e.mjs",
    "test:desktop": "node scripts/release-checks/run.mjs --group app",
    "check:test-layout": "node scripts/check-test-layout.mjs",
    "smoke:workbench-header-motion": "electron tests/integration/workbench/tabs/workbench-header-motion.smoke.mjs",
    "smoke:project-sessions": "electron tests/e2e/workspace/projects/project-sessions.smoke.mjs",
    "test:typecheck": "tsc -p tests/config/tsconfig.json && tsc -p tests/config/tsconfig.tooling.json",
    "test:core:coverage": "vitest run --config tests/config/vitest.core-coverage.config.ts",
    "smoke:resource-transfer:acceptance": "npm run build:native-drag && electron tests/integration/platform/drag-drop/resource-transfer.smoke.mjs --automated && electron tests/integration/platform/drag-drop/resource-transfer.smoke.mjs --automated --editor",
    "smoke:editor-pane-contracts": "electron tests/integration/editor/runtime/editor-pane-contracts.smoke.mjs",
    "smoke:sidebar-visibility": "electron tests/e2e/workbench/layout/sidebar-visibility.smoke.mjs",
    "smoke:sidebar-visibility:acceptance": "electron tests/e2e/workbench/layout/sidebar-visibility.smoke.mjs --native"
