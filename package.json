  "build": {
    "electronUpdaterCompatibility": ">=2.16",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/@duckdb/**",
      "electron/main/platform/macos/native/*.node"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "local-api/**",
      "locales/**",
      "shared/**",
      "packages/localization/**",
      "packages/shared-ui/**",
      "vendor/claudian/**",
      "vendor/claude-agent-sdk/**",
      "vendor/pi-kernel/**",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "LICENSE",
      "NOTICE",
      "THIRD_PARTY_NOTICES.md",
      "package.json",
      "!tests/**",
      "!**/*.test.*",
      "!**/*.spec.*",
      "!**/*.bench.*"
    ]
