    "smoke:agent-discovery-feedback": "electron tests/integration/terminal/startup/agent-discovery-feedback.smoke.mjs",
    "smoke:agent-references": "electron tests/integration/agent/references/agent-reference-ingestion.smoke.mjs",
    "smoke:agent-render-stability": "npm run build && node tests/support/runners/run-agent-render-stability-smoke.mjs",
    "smoke:agent-tool-stability": "npm run build && node tests/support/runners/run-agent-tool-stability-smoke.mjs",
    "smoke:viewer-pack": "electron tests/integration/extensions/viewer-packs/viewer-pack.smoke.mjs",
    "smoke:app-preview": "electron tests/integration/editor/formats/app-preview/app-preview-iframe.smoke.mjs",
    "smoke:html-editor": "electron tests/integration/editor/formats/html/html-visual-editor.smoke.mjs",
    "smoke:html-app": "electron tests/e2e/editor/formats/html/editor-html.smoke.mjs",
    "smoke:pdf-dom": "electron tests/integration/editor/formats/pdf/dom-embedded-pdf-surface.smoke.mjs",
    "smoke:pdf-app": "electron tests/e2e/editor/formats/pdf/editor-pdf.smoke.mjs",
    "smoke:database-app": "electron tests/e2e/editor/formats/database/editor-database.smoke.mjs",
    "audit:viewer-gpu": "electron tests/performance/scenarios/editor/viewers/audit-viewer-gpu.mjs",
