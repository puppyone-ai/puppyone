{
  "name": "@puppyone/desktop",
  "private": true,
  "version": "0.3.23",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puppyone-ai/puppyone.git"
  },
  "homepage": "https://github.com/puppyone-ai/puppyone#readme",
  "bugs": {
    "url": "https://github.com/puppyone-ai/puppyone/issues"
  },
  "type": "module",
  "main": "electron/main.mjs",
  "puppyoneCapabilities": {
    "externalViewerPacks": false,
    "gitAutoCommit": false
  },
  "scripts": {
    "check:release": "node scripts/release-checks/run.mjs",
    "generate:dmg-background": "node scripts/render-dmg-background.mjs",
    "generate:interface-styles": "node scripts/generate-interface-styles.mjs",
    "generate:sub-themes": "node scripts/generate-builtin-sub-themes.mjs",
    "check:interface-styles": "node scripts/generate-interface-styles.mjs --check",
    "check:sub-themes": "node scripts/generate-builtin-sub-themes.mjs --check",
    "check:boundaries": "npm run check:interface-styles && npm run check:sub-themes && node scripts/check-repository-layout.mjs && npm run check:test-layout && node scripts/check-puppy-brand-assets.mjs && node scripts/check-renderer-asset-architecture.mjs && node scripts/check-test-fixture-privacy.mjs && node scripts/check-local-workspace-architecture.mjs && node scripts/check-cloud-frontend-architecture.mjs && node scripts/check-repository-target-architecture.mjs && node scripts/check-desktop-platform-architecture.mjs && node scripts/check-local-agent-installation-architecture.mjs && node scripts/check-desktop-build-identity-architecture.mjs && node scripts/check-desktop-telemetry-architecture.mjs && node scripts/check-git-auto-commit-architecture.mjs && node scripts/check-macos-release-config.mjs && node scripts/check-localization.mjs && node scripts/check-renderer-style-architecture.mjs && node scripts/check-window-layout-architecture.mjs && node scripts/check-native-surface-layering.mjs && node scripts/check-data-ui-boundaries.mjs && node scripts/check-markdown-architecture.mjs && node scripts/check-viewer-contract.mjs && node scripts/check-editor-document-session.mjs && node scripts/check-sidebar-architecture.mjs && node scripts/check-workbench-architecture.mjs && node scripts/check-agent-architecture.mjs && node scripts/check-agent-activity-architecture.mjs && node scripts/check-pi-kernel-provenance.mjs && node scripts/check-claude-agent-sdk-provenance.mjs && node scripts/check-agent-ui-provenance.mjs && node scripts/check-automation-plugin-boundaries.mjs",
