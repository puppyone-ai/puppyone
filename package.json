    "smoke:appearance-dialog": "electron tests/integration/appearance/themes/appearance-visual-matrix.smoke.mjs --dialog-only",
    "smoke:workspace-menu": "electron tests/integration/workspace/projects/workspace-menu-visual.smoke.mjs",
