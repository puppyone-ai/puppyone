    "plist": "3.1.0",
    "pngjs": "7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "saxes": "^6.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
