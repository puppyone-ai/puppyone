{
  "name": "@puppyone/desktop",
  "private": true,
  "version": "0.3.18",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puppyone-ai/puppyone-desktop.git"
  },
  "homepage": "https://github.com/puppyone-ai/puppyone-desktop#readme",
  "bugs": {
    "url": "https://github.com/puppyone-ai/puppyone-desktop/issues"
  },
  "type": "module",
  "main": "electron/main.mjs",
  "puppyoneCapabilities": {
    "externalViewerPacks": false,
    "gitAutoCommit": false
  },
  "scripts": {
    "check:release": "node scripts/release-checks/run.mjs",
    "generate:dmg-background": "node scripts/render-dmg-background.mjs",
    "generate:interface-styles": "node scripts/generate-interface-styles.mjs",
    "generate:sub-themes": "node scripts/generate-builtin-sub-themes.mjs",
    "check:interface-styles": "node scripts/generate-interface-styles.mjs --check",
    "check:sub-themes": "node scripts/generate-builtin-sub-themes.mjs --check",
    "check:boundaries": "npm run check:interface-styles && npm run check:sub-themes && node scripts/check-repository-layout.mjs && node scripts/check-puppy-brand-assets.mjs && node scripts/check-renderer-asset-architecture.mjs && node scripts/check-test-fixture-privacy.mjs && node scripts/check-local-workspace-architecture.mjs && node scripts/check-cloud-frontend-architecture.mjs && node scripts/check-repository-target-architecture.mjs && node scripts/check-desktop-platform-architecture.mjs && node scripts/check-desktop-build-identity-architecture.mjs && node scripts/check-desktop-telemetry-architecture.mjs && node scripts/check-git-auto-commit-architecture.mjs && node scripts/check-macos-release-config.mjs && node scripts/check-localization.mjs && node scripts/check-renderer-style-architecture.mjs && node scripts/check-window-layout-architecture.mjs && node scripts/check-native-surface-layering.mjs && node scripts/check-data-ui-boundaries.mjs && node scripts/check-markdown-architecture.mjs && node scripts/check-viewer-contract.mjs && node scripts/check-editor-document-session.mjs && node scripts/check-sidebar-architecture.mjs && node scripts/check-workbench-architecture.mjs && node scripts/check-agent-architecture.mjs && node scripts/check-agent-activity-architecture.mjs && node scripts/check-opencode-provenance.mjs && node scripts/check-claude-agent-sdk-provenance.mjs && node scripts/check-agent-ui-provenance.mjs && node scripts/check-automation-plugin-boundaries.mjs",
    "check:puppy-brand-assets": "node scripts/check-puppy-brand-assets.mjs",
    "check:renderer-assets": "node scripts/check-renderer-asset-architecture.mjs",
    "check:test-fixture-privacy": "node scripts/check-test-fixture-privacy.mjs",
    "check:localization": "node scripts/check-localization.mjs",
    "check:shared-ui": "node scripts/check-data-ui-boundaries.mjs && node scripts/check-markdown-architecture.mjs && node scripts/check-viewer-contract.mjs && node scripts/check-editor-document-session.mjs",
    "check:editor-document-session": "node scripts/check-editor-document-session.mjs",
    "check:viewer-contract": "node scripts/check-viewer-contract.mjs",
    "check:markdown-architecture": "node scripts/check-markdown-architecture.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare:desktop-build:dev": "node scripts/prepare-desktop-build.mjs --channel dev",
    "dev": "npm run build:native-drag && npm run prepare:desktop-build:dev && node scripts/prepare-opencode-dev-runtime.mjs --optional && node scripts/dev-electron.mjs",
    "dev:update-preview": "VITE_DESKTOP_UPDATE_PREVIEW=available VITE_DESKTOP_UPDATE_PREVIEW_VERSION=0.3.0-preview.1 VITE_DESKTOP_CLOUD_API_URL=https://api.puppyone.ai/api/v1 VITE_DESKTOP_CLOUD_WEB_URL=https://app.puppyone.ai npm run dev",
    "dev:renderer": "vite",
    "dev:browser": "vite --host 127.0.0.1",
    "dev:desktop-telemetry-edge": "wrangler dev --config cloudflare/desktop-telemetry/wrangler.jsonc",
    "postinstall": "node scripts/fix-node-pty-permissions.mjs && node scripts/patch-xterm-webgl-atlas.mjs && node scripts/patch-dmg-builder-window-size.mjs",
    "build": "node scripts/check-desktop-build-environment.mjs && npm run build:native-drag && npm run check:boundaries && tsc && vite build && node scripts/check-renderer-public-assets.mjs && node scripts/check-bundle-budget.mjs && node scripts/check-packaged-artifact-budgets.mjs",
    "package:viewer-pack": "node scripts/package-viewer-pack.mjs",
    "check:artifact-budgets": "node scripts/check-packaged-artifact-budgets.mjs",
    "check:viewer-pack-trust": "node scripts/check-viewer-pack-release.mjs",
    "stage:opencode-runtime": "node scripts/stage-opencode-runtime.mjs",
    "prepare:opencode-runtime": "node scripts/prepare-opencode-dev-runtime.mjs",
    "check:opencode-release": "node scripts/check-opencode-release.mjs",
    "dist:mac": "npm run prepare:desktop-build:dev && npm run dist:mac:prepared",
    "dist:mac:prepared": "npm run check:shared-ui && npm run build && npm run check:viewer-pack-trust && npm run check:opencode-release && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config generated/electron-builder.json --mac --publish never",
    "package:terminal-preview": "node scripts/build-terminal-preview-package.mjs",
    "dist:mac:terminal-preview": "npm run dist:mac && npm run package:terminal-preview",
    "prepare:mac:release": "npm run check:shared-ui && npm run build && npm run check:viewer-pack-trust && npm run check:opencode-release",
    "package:mac:release": "node scripts/build-macos-stable-release.mjs --package-only",
    "dist:mac:release": "node scripts/build-macos-stable-release.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "smoke:local-api": "node scripts/smoke-local-api.mjs",
    "smoke:format-aware-diff": "electron scripts/smoke-format-aware-diff.mjs",
    "smoke:csv-table-layout": "electron scripts/smoke-csv-table-sticky-layout.mjs",
    "smoke:office-preview-layout": "electron scripts/smoke-office-preview-layout.mjs",
    "smoke:pptx-renderer": "electron scripts/smoke-pptx-renderer.mjs",
    "smoke:markdown-table-inline-viewport": "electron scripts/smoke-markdown-table-inline-viewport.mjs",
    "smoke:markdown-pane-focus-continuity": "electron scripts/smoke-markdown-pane-focus-continuity.mjs",
    "smoke:native-resize-cursor": "electron scripts/smoke-native-resize-cursor.mjs",
    "smoke:editor-runtime-lifecycle": "electron scripts/smoke-editor-runtime-lifecycle.mjs",
    "smoke:markdown-line-geometry": "npm run build && electron scripts/smoke-markdown-line-geometry.mjs",
    "smoke:markdown-theme-inheritance": "npm run build && electron scripts/smoke-markdown-theme-inheritance.mjs",
    "smoke:appearance-visual": "electron scripts/smoke-appearance-visual-matrix.mjs && npm run smoke:typography-hierarchy",
    "smoke:typography-hierarchy": "electron scripts/smoke-typography-hierarchy.mjs",
    "smoke:appearance-dialog": "electron scripts/smoke-appearance-visual-matrix.mjs --dialog-only",
    "smoke:workspace-menu": "electron scripts/smoke-workspace-menu-visual.mjs",
    "smoke:codex-agent": "node scripts/smoke-codex-app-server.mjs",
    "smoke:agent-markdown": "npm run build && electron scripts/smoke-agent-markdown.mjs",
    "smoke:agent-approval": "npm run build && electron scripts/smoke-agent-approval.mjs",
    "smoke:native-agents": "node scripts/smoke-native-agent-roundtrip.mjs",
    "smoke:native-agent-references": "node scripts/smoke-native-agent-references.mjs",
    "smoke:terminal-p0": "electron scripts/smoke-terminal-p0.mjs",
    "smoke:item-utilities": "electron scripts/smoke-item-utility-isolation.mjs",
    "smoke:item-renderers": "electron scripts/smoke-item-renderer-isolation.mjs",
    "smoke:auxiliary-appearance": "electron scripts/smoke-auxiliary-appearance.mjs",
    "smoke:agent-references": "electron scripts/smoke-agent-reference-ingestion.mjs",
    "smoke:agent-render-stability": "npm run build && node scripts/run-agent-render-stability-smoke.mjs",
    "smoke:agent-tool-stability": "npm run build && node scripts/run-agent-tool-stability-smoke.mjs",
    "smoke:viewer-pack": "electron scripts/smoke-viewer-pack.mjs",
    "smoke:app-preview": "electron scripts/smoke-app-preview-iframe.mjs",
    "smoke:pdf-isolated": "electron scripts/smoke-isolated-pdf-surface.mjs",
    "audit:viewer-gpu": "electron scripts/audit-viewer-gpu.mjs",
    "smoke:renderer-performance": "npm run build && node scripts/run-renderer-performance-smoke.mjs",
    "smoke:renderer-cold-performance": "npm run build && node scripts/run-renderer-performance-smoke.mjs --cold --visible --with-link-index",
    "smoke:csv-performance": "npm run build && node scripts/run-csv-editor-performance-smoke.mjs",
    "start": "node scripts/start-electron.mjs",
    "test": "vitest run",
    "test:updater-p0": "vitest run --config vitest.updater-p0.config.mjs",
    "test:updater-p0:coverage": "vitest run --config vitest.updater-p0.config.mjs --coverage",
    "test:git-auto-commit": "vitest run --config vitest.git-auto-commit.config.mjs",
    "test:git-auto-commit:coverage": "vitest run --config vitest.git-auto-commit.config.mjs --coverage",
    "test:desktop-platform-contracts": "vitest run tests/desktopPlatformArchitecture.test.mjs tests/desktopReleaseSet.test.mjs tests/desktopBuildIdentity.test.mjs tests/electron.build-info-service.test.mjs tests/electron.platform-host.test.mjs tests/electron.terminal-agent-launch.test.mjs tests/electron.cloud-publish-git-credentials.test.mjs",
    "test:desktop-telemetry": "vitest run tests/electron.desktop-telemetry-*.test.mjs tests/cloudflare.desktop-telemetry-*.test.mjs",
    "check:desktop-telemetry-edge": "wrangler deploy --dry-run --config cloudflare/desktop-telemetry/wrangler.jsonc",
    "test:watch": "vitest",
    "bench:performance": "vitest bench --run benchmarks/performance --no-file-parallelism --maxWorkers=1",
    "build:native-drag": "node scripts/build-native-resource-drag.mjs",
    "smoke:resource-transfer": "npm run build:native-drag && electron scripts/smoke-resource-transfer.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.159",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "6.0.0",
    "diff": "9.0.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "intl-messageformat": "^11.2.2",
    "jszip": "^3.10.1",
    "node-pty": "^1.1.0",
    "postcss": "^8.5.26",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "semver": "^7.7.3"
  },
  "devDependencies": {
    "@aiden0z/pptx-renderer": "^1.2.4",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@electron/asar": "3.4.1",
    "@formatjs/icu-messageformat-parser": "3.5.5",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.4",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ajv": "8.20.0",
    "autoprefixer": "^10.5.0",
    "docx-preview": "^0.4.0",
    "electron": "^41.10.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "katex": "^0.16.47",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.16.1",
    "node-api-headers": "1.9.0",
    "pdfjs-dist": "^6.2.108",
    "plist": "3.1.0",
    "pngjs": "7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "saxes": "^6.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wrangler": "4.127.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "build": {
    "electronUpdaterCompatibility": ">=2.16",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**",
      "electron/main/platform/macos/native/*.node"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "local-api/**",
      "locales/**",
      "shared/**",
      "packages/localization/**",
      "packages/shared-ui/**",
      "vendor/claudian/**",
      "vendor/claude-agent-sdk/**",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "LICENSE",
      "NOTICE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/opencode",
        "to": "opencode",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
