    "check:artifact-budgets": "node scripts/check-packaged-artifact-budgets.mjs",
    "check:viewer-pack-trust": "node scripts/check-viewer-pack-release.mjs",
    "dist:mac": "npm run prepare:desktop-build:dev && npm run dist:mac:prepared",
    "dist:mac:prepared": "npm run check:shared-ui && npm run build && npm run check:viewer-pack-trust && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config generated/electron-builder.json --mac --publish never",
    "package:terminal-preview": "node scripts/build-terminal-preview-package.mjs",
    "dist:mac:terminal-preview": "npm run dist:mac && npm run package:terminal-preview",
    "prepare:mac:release": "npm run check:shared-ui && npm run build && npm run check:viewer-pack-trust",
    "package:mac:release": "node scripts/build-macos-stable-release.mjs --package-only",
    "dist:mac:release": "node scripts/build-macos-stable-release.mjs",
    "prepare:windows:release": "npm run check:shared-ui && npm run build && npm run check:viewer-pack-trust",
    "package:windows:prepared": "electron-builder --config generated/electron-builder.json --win nsis --x64 --publish never",
    "package:windows:release": "npm run package:windows:prepared && node scripts/verify-packaged-desktop-build.mjs --target windows-x64",
    "preview": "vite preview --host 127.0.0.1",
    "smoke:local-api": "node tests/integration/workspace/files/local-api.smoke.mjs",
    "smoke:format-aware-diff": "electron tests/integration/source-control/diff/format-aware-diff.smoke.mjs",
    "smoke:csv-table-layout": "electron tests/integration/editor/formats/csv/csv-table-sticky-layout.smoke.mjs",
    "smoke:office-preview-layout": "electron tests/integration/editor/formats/office/office-preview-layout.smoke.mjs",
    "smoke:pptx-renderer": "electron tests/integration/editor/formats/office/pptx-renderer.smoke.mjs",
    "smoke:markdown-table-inline-viewport": "electron tests/integration/editor/formats/markdown/tables/markdown-table-inline-viewport.smoke.mjs",
    "smoke:markdown-pane-focus-continuity": "electron tests/integration/workbench/focus/markdown-pane-focus-continuity.smoke.mjs",
    "smoke:native-resize-cursor": "electron tests/integration/platform/native-surfaces/native-resize-cursor.smoke.mjs",
    "smoke:editor-runtime-lifecycle": "electron tests/integration/editor/runtime/editor-runtime-lifecycle.smoke.mjs",
