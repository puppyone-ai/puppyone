    "docx-preview": "^0.4.0",
    "electron": "^41.10.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "js-yaml": "4.3.2",
    "katex": "^0.16.47",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.16.1",
