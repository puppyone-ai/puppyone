    "packages/shared-ui/src/editor"
  ],
  "excluded_patterns": [
    {
      "pattern": "**/*VisualSmokeHarness.tsx",
      "reason": "Browser visual-smoke harness; native verification uses capture modes and Rust tests."
    },
    {
      "pattern": "**/*SmokeHarness.tsx",
      "reason": "Browser visual-smoke harness; native verification uses capture modes and Rust tests."
    },
    {
      "pattern": "**/*visual-smoke*",
      "reason": "Styles or fixtures used only by browser visual-smoke harnesses."
    },
    {
      "pattern": "**/README.md",
      "reason": "Documentation, not runtime behaviour."
    },
    {
      "pattern": "**/index.ts",
      "reason": "Module barrel; re-exports only. Rust modules use mod.rs/pub use."
    }
  ],
