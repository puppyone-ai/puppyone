{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020", "ES2021.Intl"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "baseUrl": ".",
    "paths": {
      "@puppyone/localization": ["src/lib/localization/index.ts"],
      "@puppyone/localization/*": ["src/lib/localization/*"],
      "@puppyone/shared-ui": ["src/shared-ui/index.ts"],
      "@puppyone/shared-ui/markdown-presentation-preview": ["src/shared-ui/editor/markdown/MarkdownPresentationPreview.tsx"],
      "lucide-react": ["node_modules/lucide-react/dist/lucide-react.d.ts"],
      "react": ["node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["node_modules/@types/react/jsx-runtime.d.ts"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src", "shared/agent-contract/**/*.ts", "shared/agent-activity-contract/**/*.ts", "shared/local-agent-installation/**/*.ts", "shared/host-contract/**/*.ts"],
  "references": []
}
