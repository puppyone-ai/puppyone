{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environment", "checks"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "environment": {"$ref": "#/definitions/environment"},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "group", "command", "platforms", "dependsOn", "timeoutSeconds", "runtime", "artifacts"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "name": {"type": "string", "minLength": 1},
          "group": {"enum": ["source", "app", "platform"]},
          "command": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
          "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["linux", "darwin", "win32"]}},
          "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 1800},
          "runtime": {"enum": ["node", "electron"]},
          "environment": {"$ref": "#/definitions/environment"},
          "artifacts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  },
  "definitions": {
    "environment": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Z][A-Z0-9_]*$"},
      "additionalProperties": {"type": "string"}
    }
  }
}
